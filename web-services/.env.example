# Public Stilloak backend API base, normally ending in /api.
# Example: https://api.example.com/api
VITE_API_URL=

# Optional direct override for the public Web order endpoint.
# When set, this takes precedence over VITE_API_URL.
VITE_WEB_LEAD_ENDPOINT=

VITE_WEB_CONTACT_EMAIL=hello@stilloak-studio.com
