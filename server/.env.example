PORT=5000
# If port 5000 is busy locally, use PORT=5001 and update client/.env VITE_API_URL to match.
NODE_ENV=development
TRUST_PROXY=false
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/manoshop
MONGO_DB_NAME=manoshop
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<dbUser>:<dbPassword>@<clusterName>.<hash>.mongodb.net/manoshop?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=super_secret_key_here
JWT_EXPIRES_IN=7d
# Password reset links use this public frontend URL. Defaults to the first CLIENT_URL when omitted.
PASSWORD_RESET_BASE_URL=http://localhost:5174
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_VERIFICATION_BASE_URL=http://localhost:5174
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# Put the primary frontend URL first.
# Additional origins can be comma-separated, including preview or wildcard hosts.
# Example: CLIENT_URL=https://www.manoshop.lt,https://manoshop.vercel.app,https://*.vercel.app
CLIENT_URL=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
COMPANY_NAME=Stilloak Studio
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Master switch for Stilloak Web Stripe deposits. Keep false while bank transfer is the only payment option.
WEB_STRIPE_DEPOSITS_ENABLED=false
# Extra production safety lock. A sk_live_ Stripe key is ignored for Stilloak Web deposits unless this is explicitly true.
# Test keys (sk_test_) can still be used when WEB_STRIPE_DEPOSITS_ENABLED=true.
WEB_SERVICE_STRIPE_LIVE_ENABLED=false
# Bank-transfer details are returned only after the client accepts a tokenized proposal.
WEB_BANK_TRANSFER_BENEFICIARY=Your Name Or Business
WEB_BANK_TRANSFER_IBAN=LT00 0000 0000 0000 0000
WEB_BANK_TRANSFER_BIC=BANKBIC1
WEB_BANK_TRANSFER_BANK_NAME=Your Bank
# Optional in development. Required in production for paid subscription prices.
# Demo/basic is an internal free plan and does not use Stripe Checkout.
STRIPE_PRICE_ASMENINIS=price_replace_asmeninis
STRIPE_PRICE_PRIVATUS_VERSLAS=price_replace_privatus_verslas
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Optional: tax behavior for Stripe Checkout price_data line items used by product checkout.
STRIPE_DYNAMIC_TAX_BEHAVIOR=exclusive
# Transactional emails prefer Brevo API over HTTPS when BREVO_API_KEY is present.
# This is the safest option on Render free instances because SMTP ports may be blocked.
EMAIL_FROM=Stilloak Studio <hello@stilloak-studio.com>
# Optional. New web-order admin alerts go here. When omitted, EMAIL_FROM address is used.
WEB_ORDERS_NOTIFY_EMAIL=hello@stilloak-studio.com
EMAIL_LOGO_URL=https://www.stilloak-studio.com/favicon.svg
BREVO_API_KEY=your_brevo_api_key
BREVO_API_TIMEOUT=15000
# Shared secret for POST /api/email-events/webhook delivery, bounce and spam events.
EMAIL_EVENT_WEBHOOK_SECRET=replace_with_a_long_random_secret
# SMTP stays available as a fallback for environments that allow outbound SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
BREVO_LAUNCH_SOON_LIST_ID=123
SAVINGS_STUDIO_SUMMARY_SCHEDULER_ENABLED=true
SAVINGS_STUDIO_SUMMARY_INTERVAL_MINUTES=15
# Encrypted daily database backups. Keep disabled until a private HTTPS upload endpoint is configured.
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_UPLOAD_URL=https://private-backup.example.com/upload
DATABASE_BACKUP_UPLOAD_TOKEN=replace_with_scoped_upload_token
DATABASE_BACKUP_ENCRYPTION_KEY=replace_with_32_byte_base64_or_64_hex_key
