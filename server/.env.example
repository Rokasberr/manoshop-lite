PORT=5000
# If port 5000 is busy locally, use PORT=5001 and update client/.env VITE_API_URL to match.
NODE_ENV=development
TRUST_PROXY=false
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/manoshop
MONGO_DB_NAME=manoshop
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<dbUser>:<dbPassword>@<clusterName>.<hash>.mongodb.net/manoshop?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=super_secret_key_here
JWT_EXPIRES_IN=7d
# Password reset links use this public frontend URL. Defaults to the first CLIENT_URL when omitted.
PASSWORD_RESET_BASE_URL=http://localhost:5174
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Put the primary frontend URL first.
# Additional origins can be comma-separated, including preview or wildcard hosts.
# Example: CLIENT_URL=https://www.manoshop.lt,https://manoshop.vercel.app,https://*.vercel.app
CLIENT_URL=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
COMPANY_NAME=Stilloak Studio
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional in development. Required in production for paid subscription prices.
# Demo/basic is an internal free plan and does not use Stripe Checkout.
STRIPE_PRICE_ASMENINIS=price_replace_asmeninis
STRIPE_PRICE_PRIVATUS_VERSLAS=price_replace_privatus_verslas
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Optional: tax behavior for Stripe Checkout price_data line items used by product checkout.
STRIPE_DYNAMIC_TAX_BEHAVIOR=exclusive
# Summary emails prefer Brevo API over HTTPS when BREVO_API_KEY is present.
# This is the safest option on Render free instances because SMTP ports may be blocked.
EMAIL_FROM=Stilloak Studio <hello@stilloak-studio.com>
EMAIL_LOGO_URL=https://www.stilloak-studio.com/favicon.svg
BREVO_API_KEY=your_brevo_api_key
BREVO_API_TIMEOUT=15000
# SMTP stays available as a fallback for environments that allow outbound SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
BREVO_LAUNCH_SOON_LIST_ID=123
SAVINGS_STUDIO_SUMMARY_SCHEDULER_ENABLED=true
SAVINGS_STUDIO_SUMMARY_INTERVAL_MINUTES=15
