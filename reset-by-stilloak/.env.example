# Public URLs
RESET_APP_URL=http://localhost:5173
RESET_API_URL=http://localhost:4000

# Database and secure sessions. Use separate users/databases for Preview and Production.
RESET_MONGO_URI=
RESET_JWT_SECRET=
# Production must use __Host-reset_session; local and Preview may use reset_session.
RESET_COOKIE_NAME=reset_session

# Stripe: use a restricted test key in Preview and a restricted live key only in Production.
# RESET_STRIPE_LIVE_ENABLED must stay false outside Production.
RESET_STRIPE_SECRET_KEY=
RESET_STRIPE_WEBHOOK_SECRET=
RESET_STRIPE_LIFETIME_PRICE_ID=
RESET_STRIPE_LIVE_ENABLED=false

# Email: Brevo API is preferred; SMTP is the fallback
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RESET by Stilloak <hello@stilloak-studio.com>

# Vercel Cron authorization and the single intended admin account.
CRON_SECRET=
RESET_ADMIN_EMAIL=
